{
  "mcpServers": {
    "mcp-gopls": {
      "command": "mcp-gopls",
      "args": [
        "--workspace",
        "${workspaceFolder}"
      ],
      "env": {
        "MCP_GOPLS_LOG_LEVEL": "info",
        "PATH": "/go/bin:${userHome}/go/bin:${env:PATH}"
      }
    },
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-sqlite",
        "--db",
        "${workspaceFolder}/data/arx.db"
      ],
      "env": {
        "SQLITE_DB_PATH": "${workspaceFolder}/data/arx.db"
      }
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "${workspaceFolder}/.cursor/arx-ca-memory.jsonl"
      }
    },
    "ast-grep": {
      "command": "npx",
      "args": [
        "-y",
        "ast-grep-mcp"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
