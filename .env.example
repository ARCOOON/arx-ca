# Copy to .env for Docker Compose: cp .env.example .env
#
# Required for docker compose up (see docker-compose.yml).
CA_API_JWT_SECRET=change-me-use-openssl-rand-base64-32

# Optional JWT settings (defaults shown)
CA_API_JWT_ISSUER=arx-ca
CA_API_JWT_EXPIRY=24h

# Server listen and PKI paths (Docker image defaults)
CA_API_LISTEN_ADDR=:8080
CA_API_CA_CONFIG=/app/data/config/ca.json

# Database — default stack uses embedded BadgerDB in the PKI data volume.
# Application admin users use SQLite at .pki/arx-ca-users.db unless overridden.
# Uncomment for external PostgreSQL (also configure ca.json db block):
# CA_API_DB_TYPE=postgresql
# CA_API_DB_DATA_SOURCE=postgres://user:pass@host:5432/arx_ca?sslmode=disable

# Bootstrap admin — seeded on first start when the users table is empty
CA_API_BOOTSTRAP_ADMIN_EMAIL=admin@arx.local
CA_API_BOOTSTRAP_ADMIN_PASSWORD=changeme

# OpenTelemetry — disable when no collector is running (recommended for local dev)
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=arx-ca
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
