# Copy to .env for Docker Compose: cp .env.example .env
#
# Required for production Docker Compose (see docker-compose.yml).
ARX_CA_PASSWORD=change-me-use-openssl-rand-base64-32
ARX_HEALTHCHECK_PASSWORD=changeme

# Optional JWT settings (auto-generated in /data/server.toml on first boot if unset)
CA_API_JWT_SECRET=
CA_API_JWT_ISSUER=arx-ca
CA_API_JWT_EXPIRY=24h

# Health probe credentials for GET /api/v1/ca/info (deploy/docker-healthcheck.sh)
ARX_HEALTHCHECK_EMAIL=admin@arx.local

# Bootstrap admin — seeded on first start when the users table is empty
CA_API_BOOTSTRAP_ADMIN_EMAIL=admin@arx.local
CA_API_BOOTSTRAP_ADMIN_PASSWORD=changeme

# OpenTelemetry — disable when no collector is running (recommended for local dev)
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=arx-ca
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
