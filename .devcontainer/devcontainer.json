{
  "name": "ARX CA",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "service": "workspace",
  "workspaceFolder": "/workspaces/arx-ca",
  "remoteEnv": {
    "ARX_DATABASE_HOST": "db",
    "ARX_DATABASE_PASSWORD": "devpassword"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:3": {
      "version": "latest",
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "features": {
      "ghcr.io/devcontainers/features/python:1": {
        "version": "3.12",
        "installTools": true,
        "toolsToInstall": "ruff,flake8,autopep8,black,mypy,bandit,pipenv,virtualenv,pylint"
      }
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "ms-playwright.playwright",
        "yzhang.markdown-all-in-one",
        "ms-azuretools.vscode-containers",
        "carlwr.better-makefile",
        "codezombiech.gitignore",
        "github.vscode-github-actions",
        "formulahendry.code-runner",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
