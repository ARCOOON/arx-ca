.env
.env.*
!.env.example
*.pem
*.key
*.crt
credentials.json
secrets/

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Debug and profiling
debug
*.prof
*.pprof

# Local configuration overrides
config.local.yaml
config.local.json

# Local PKI material generated at runtime or during tests
.pki/
.pki-test/

# Docker Compose persistent PKI volume
data/

